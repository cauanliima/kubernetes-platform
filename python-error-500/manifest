apiVersion: apps/v1
kind: Deployment
metadata:
  name: slow-api
spec:
  replicas: 1
  selector:
    matchLabels:
      app: slow-api
  template:
    metadata:
      labels:
        app: slow-api
    spec:
      containers:
        - name: slow-api
          image: cauanliima/flask-mongo-vault:2 
          ports:
            - containerPort: 8080
          resources:
            limits:
              cpu: "200m"
              memory: "128Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: slow-api
spec:
  selector:
    app: slow-api
  type: NodePort
  ports:
    - port: 80
      targetPort: 8080
      nodePort: 31004
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-load-generator
spec:
  replicas: 1
  selector:
    matchLabels:
      app: api-load-generator
  template:
    metadata:
      labels:
        app: api-load-generator
    spec:
      containers:
        - name: load-gen
          image: busybox
          command: ["/bin/sh", "-c"]
          args:
            - >
              while true; do
                wget -qO- http://slow-api/;
                sleep 0.2;
              done

